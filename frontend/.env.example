# Colegio Interlaken — frontend environment template.
# Copy to .env.local and fill in real values. NEVER commit .env.local.

VITE_API_BASE_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# WhatsApp number (digits only, country code first) for the "Reservar por
# WhatsApp" deep-link buttons. Falls back to a placeholder if unset.
VITE_WHATSAPP_NUMBER=5215512345678

# Error monitoring (Sentry) — optional. Leave blank to disable (no-op).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Web analytics — optional, consent-gated. Configure AT MOST ONE provider.
# Leave both blank to disable analytics entirely (no banner, no trackers).
VITE_GA4_MEASUREMENT_ID=
VITE_PLAUSIBLE_DOMAIN=
# Self-hosted Plausible script URL (optional; defaults to plausible.io manual script).
VITE_PLAUSIBLE_SRC=

# Web push (PWA notifications) — optional, opt-in. VAPID public key from the
# backend push key pair. Leave blank to disable push subscription (no-op).
VITE_VAPID_PUBLIC_KEY=
