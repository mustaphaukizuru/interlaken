# Colegio Interlaken — frontend environment template.
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# Leave BLANK so the SPA calls the API same-origin (dev: Vite proxy; prod: served
# by Django). Same-origin is REQUIRED for the httpOnly auth cookies to be sent —
# see AUTH.md. Only set an absolute host for a split-origin deployment (then the
# backend must set AUTH_COOKIE_SAMESITE=None + AUTH_COOKIE_SECURE=True over HTTPS).
VITE_API_BASE_URL=
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# WhatsApp number (digits only, country code first) — build-time fallback for
# the wa.me deep links. The runtime value comes from the admin-editable site
# settings (Contenido del sitio → Ajustes del sitio).
VITE_WHATSAPP_NUMBER=5215553791188

# Error monitoring (Sentry) — optional. Leave blank to disable (no-op).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Web analytics — optional, consent-gated. Configure AT MOST ONE provider.
# Leave both blank to disable analytics entirely (no banner, no trackers).
VITE_GA4_MEASUREMENT_ID=
VITE_PLAUSIBLE_DOMAIN=
# Self-hosted Plausible script URL (optional; defaults to plausible.io manual script).
VITE_PLAUSIBLE_SRC=

# Web push (PWA notifications) — optional, opt-in. VAPID public key from the
# backend push key pair. Leave blank to disable push subscription (no-op).
VITE_VAPID_PUBLIC_KEY=
