###############################################################################
# Colegio Interlaken — frontend .env EXAMPLE (safe to commit)
# Copy to frontend/.env.local and replace every __PASTE__.
###############################################################################

# Leave BLANK for same-origin (Vite proxy / Django). Required for auth cookies.
VITE_API_BASE_URL=

# Same as backend GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=__PASTE__.apps.googleusercontent.com

VITE_WHATSAPP_NUMBER=5215553791188

# Same PUBLIC key as backend VAPID_PUBLIC_KEY (optional)
VITE_VAPID_PUBLIC_KEY=

VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Analytics — at most ONE of these (or leave both blank)
VITE_GA4_MEASUREMENT_ID=
VITE_PLAUSIBLE_DOMAIN=
# VITE_PLAUSIBLE_SRC=
