# Copy to deploy/.env on the VPS and fill in. NEVER commit the filled copy.
#   cp env.example .env && chmod 600 .env
#
# Values marked CARRY OVER must be copied verbatim from the previous
# environment. Generating new ones has consequences noted inline.

# ── THE PUBLIC ADDRESS ── set this one line and everything else follows ─────
# Django needs this value in six shapes (ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS,
# CORS_ALLOWED_ORIGINS, FRONTEND_URL, BACKEND_URL, GOOGLE_REDIRECT_URI).
# docker-compose.yml derives all six from this single variable, so this is the
# only place the domain is written. Do not add those six here: values in
# compose's `environment:` block override anything set in this file, so a copy
# kept here would be ignored and would only mislead the next person.
#
# The app IS the school site (its own metadata declares this domain canonical
# nine times over), so it serves the apex. Caddy also answers www and redirects
# it here, and both names get certificates.
PORTAL_DOMAIN=interlaken.edu.mx

# REQUIRED. Caddy refuses to start with this empty, which takes the whole site
# down. Where Let's Encrypt sends warnings if renewal ever fails.
TLS_EMAIL=
WEB_CONCURRENCY=3

# ── Django core ─────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.production
# CARRY OVER. Changing it logs every user out and invalidates password-reset
# and email-confirmation links that are already in inboxes.
SECRET_KEY=
# CARRY OVER. This key decrypts existing encrypted database fields. A new value
# does not fail loudly, it just makes already-stored data unreadable forever.
FIELD_ENCRYPTION_KEY=

# ── Database: Postgres, running on this box ─────────────────────────────────
# The db service in docker-compose.yml. DB_HOST, DB_PORT and DB_SSLMODE are set
# in compose (not here) so a stale value cannot point production elsewhere.
#
# These credentials CREATE the database on the db volume's first boot. Editing
# DB_PASSWORD afterwards does NOT change it: the volume keeps what it was
# initialised with, and the app then fails to authenticate. To rotate:
#   docker compose exec db psql -U <user> -d <db> -c "ALTER USER <user> WITH PASSWORD '<new>';"
# and only then update this file.
DB_NAME=interlaken
DB_USER=interlaken
# Generate: openssl rand -base64 32
DB_PASSWORD=

# WHERE THE DATABASE LIVES. Two supported setups; the default is the first.
#
#   1. External database (current): set DB_HOST to its host. This is what the
#      school runs today - a managed Postgres - and nothing here starts a
#      database container.
#
#   2. Postgres on this box: add the overlay line below and delete DB_HOST.
#      COMPOSE_FILE makes every compose command - deploy.sh and backup-db.sh
#      included - pick up the extra file automatically.
#          COMPOSE_FILE=docker-compose.yml:docker-compose.localdb.yml
#      Moving existing data across is ./migrate-from-external-db.sh; it is not
#      required reading unless you want the data local.
#
# deploy.sh prints which of the two it is using on every run, and refuses if
# neither is configured.
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require
CONN_MAX_AGE=60

# (ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS, CORS_ALLOWED_ORIGINS, FRONTEND_URL and
#  BACKEND_URL are derived from PORTAL_DOMAIN in docker-compose.yml. Nothing to
#  set here.)

# ── Behind the reverse proxy ────────────────────────────────────────────────
# Set in docker-compose.yml, not here: TRUST_PROXY_IP_HEADER makes Django read
# the real client IP from Caddy instead of seeing every visitor as one address.
# Without it, rate limiting and brute-force lockout apply to the whole school
# at once. Never enable it for a deployment whose app port is publicly
# reachable, or clients could forge their own address.

# ── Loyverse cafeteria ──────────────────────────────────────────────────────
LOYVERSE_API_TOKEN=
# Same secret that is inside the webhook URL registered in Loyverse.
LOYVERSE_WEBHOOK_SECRET=
CAFETERIA_PURCHASE_DIGEST=false
# Card top-ups reach the wallet once staff load them into the Loyverse POS
# (scheduled, default) or on payment (instant). Load time, cutoff before it and
# the WhatsApp families write to for same-day requests (10 digits).
CAFETERIA_TOPUP_APPLY_MODE=scheduled
CAFETERIA_TOPUP_APPLY_TIME=07:30
CAFETERIA_TOPUP_APPLY_CUTOFF_MINUTES=30
CAFETERIA_TOPUP_WHATSAPP=5553791188

# ── Object storage for uploaded documents ───────────────────────────────────
# Leave the bucket name EMPTY and uploads fall back to MEDIA_ROOT, which
# compose maps to the persistent `media` volume so they survive deploys.
# Filling it in switches to Supabase Storage, which is the better end state.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# ── Email ───────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# NOTE: interlaken.edu.mx currently has NO MX records, so mail cannot be
# RECEIVED at this domain. Sending still works through the SMTP server below,
# but add SPF and DKIM for that host or the mail will land in spam.
DEFAULT_FROM_EMAIL=noreply@interlaken.edu.mx
CONTACT_EMAIL=info@interlaken.com.mx
ADMISSIONS_EMAIL=info@interlaken.com.mx
BILLING_EMAIL=facturas@interlaken.com.mx
# Buzón del formulario de /contacto (por omisión pmaya@interlaken.com.mx).
CONTACT_FORM_EMAIL=pmaya@interlaken.com.mx
SUPPORT_EMAIL=info@interlaken.com.mx

# ── Google sign-in ──────────────────────────────────────────────────────────
# GOOGLE_REDIRECT_URI is derived from PORTAL_DOMAIN in docker-compose.yml as
# https://<domain>/auth/google/callback/ . That exact URI must ALSO be added as
# an authorised redirect URI in the Google Cloud console, or sign-in fails with
# redirect_uri_mismatch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTO_CREATE_DOMAINS=

# ── Payments: Banorte only (docs/BANORTE-INTEGRATION.md) ───────────────────
# Afiliación, Usuario (Nick of the "usuario de motor" from MultiCobros), Contraseña,
# ID Terminal, Ciudad and Nombre del comercio as Banorte delivered them.
# PAYMENTS_LIVE=true sends every checkout as PRD (real money): turn it on only
# for the certification transactions and after the certification letter.
PAYMENTS_LIVE=false
BANORTE_MERCHANT_ID=
BANORTE_USER=
BANORTE_PASSWORD=
BANORTE_TERMINAL_ID=
# Quote with single quotes any value that has a space or a $: deploy.sh reads
# this file with bash, and an unquoted space aborts the deploy before it starts
# ("INTERLAKEN: command not found"); a $ is expanded by bash and by Compose.
BANORTE_MERCHANT_NAME='COLEGIO INTERLAKEN'
BANORTE_MERCHANT_CITY=
# e.g. BANORTE_MERCHANT_CITY='TLALNEPANTLA DE BAZ'
# Payworks simulation while PAYMENTS_LIVE=false: AUT, DEC or RND.
BANORTE_MODE=AUT
# Banorte's yearly certificate (renewed every March): the Base64 body of the
# .cer on ONE line (the text between BEGIN/END CERTIFICATE, newlines removed).
# `docker compose exec app python manage.py check_banorte` shows its expiry.
BANORTE_CERT=
# While PAYMENTS_LIVE=false a deployed server runs Banorte's simulation (every
# card approved): only these comma-separated accounts may pay online there.
PAYMENTS_TEST_EMAILS=
# PAYMENTS_LIVE=true + this false = certification (real charges, test accounts
# only). Set true only after Banorte's certification letter: every family pays.
PAYMENTS_OPEN_TO_ALL=false

# ── WhatsApp notifications ──────────────────────────────────────────────────
# Parent alerts fall back to email when these are unset.
WHATSAPP_NUMBER=
WHATSAPP_API_VERSION=v19.0
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ── Google Calendar (visit bookings) ────────────────────────────────────────
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_SA_KEY=

# ── Cafeteria sync watermark ────────────────────────────────────────────────
# Only consulted on the very FIRST purchase poll, before the database has its
# own cursor. Leaving it empty makes that first run start from "now", which is
# the safe default: replaying historical receipts would double-debit balances
# that were already seeded from Loyverse points.
CAFETERIA_SYNC_PURCHASES_SINCE=

# ── Optional ────────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=
LOG_LEVEL=INFO

# ── Build-time only (baked into the SPA bundle) ─────────────────────────────
VITE_VAPID_PUBLIC_KEY=
VITE_SENTRY_DSN=

# ── First boot only ─────────────────────────────────────────────────────────
# Creates the admin account, then DELETE these four lines and redeploy. On a
# VPS you have `docker compose exec`, so there is no reason to keep a password
# sitting in a file on disk.
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_FIRST_NAME=
DJANGO_SUPERUSER_LAST_NAME=
