# Caddy obtains and renews the Let's Encrypt certificates automatically. There
# is no certbot and no renewal cron to forget; that is the reason Caddy is here
# rather than nginx or the OpenLiteSpeed the VPS template shipped with.

{
	# Caddy will not start if this is empty, so compose refuses to bring the
	# stack up with an unset TLS_EMAIL rather than leaving the site dark.
	email {$TLS_EMAIL}
}

# ── www redirects to the apex ───────────────────────────────────────────────
# The app declares https://interlaken.edu.mx as its canonical URL in its own
# metadata and structured data, so serving both names would split search
# ranking and produce two URLs for every page. Its own certificate is issued
# here too, otherwise visitors typing www would hit a TLS warning before the
# redirect could ever run. The http:// address is listed explicitly so
# http://www goes to https://apex in ONE hop (Caddy's automatic HTTPS redirect
# went http://www → https://www → https://apex).
www.{$PORTAL_DOMAIN}, http://www.{$PORTAL_DOMAIN} {
	redir https://{$PORTAL_DOMAIN}{uri} permanent
}

# ── Old domains (interlaken.com.mx, colegiointerlaken.edu.mx) ───────────────
# Once their A records point at this server, every old URL answers ONE 301 to
# the matching page here, so the ranking the old site earned since 2009 moves
# over instead of ending on a 404 or the home page. LEGACY_DOMAINS (deploy/.env)
# lists each host twice, https and http, e.g.
#   LEGACY_DOMAINS=interlaken.com.mx, www.interlaken.com.mx, http://interlaken.com.mx, http://www.interlaken.com.mx
# Unset, the block binds a dummy http-only name and does nothing. Never add a
# host before its DNS points here: Caddy would retry its certificate forever.
# MX/TXT records are untouched by this, so Google Workspace mail keeps working.
{$LEGACY_DOMAINS:http://legacy.invalid} {
	map {path} {legacy_path} {
		# Old static site (2017-2026)
		/index.html          /
		/index-pre.html      /niveles/preescolar
		/index-pri.html      /niveles/primaria
		/index-sec.html      /niveles/secundaria
		/index-1.html        /admisiones
		/index-1a.html       /admisiones
		/index-1b.html       /admisiones/documentacion
		/index-1c.html       /admisiones/costos
		/index-2.html        /plataformas
		/index-2pre.php      /plataformas
		/index-2pri.php      /plataformas
		/index-2sec.php      /plataformas
		/index-21pre.php     /plataformas
		/index-22pre.php     /plataformas
		/index-23pre.php     /plataformas
		/index-2mat.php      /plataformas
		/index-2precal.php   /niveles/preescolar
		/index-2prical.php   /niveles/primaria
		/index-2seccal.php   /niveles/secundaria
		/index-3.html        /plataformas
		/index-4.html        /galeria
		/index-4inst.html    /galeria
		/index-4eve.html     /galeria
		/index-5.html        /contacto
		/index-6.html        /aviso-de-privacidad
		/index-7.html        /comunidad/facturacion
		/AvisoPrivacidad.pdf /aviso-de-privacidad
		# PHP site (2009-2016)
		/1colegio.php        /nosotros
		/2preescolar.php     /niveles/preescolar
		/3primaria.php       /niveles/primaria
		/4secundaria.php     /niveles/secundaria
		/5admisiones.php     /admisiones
		/admisiones.php      /admisiones
		/6galeria.php        /galeria
		/12instalaciones.php /galeria
		/13videos.php        /galeria
		/7circulares.php     /plataformas
		/8contacto.php       /contacto
		/11aviso.php         /aviso-de-privacidad
		/14registro.php      /pre-registro
		/actividades.php     /modelo-educativo
		# Anything else keeps its path: new-style links (/admisiones) land on
		# the right page, and true leftovers get the new site's honest 404.
		default              {path}
	}
	redir https://{$PORTAL_DOMAIN}{legacy_path} permanent
}

# ── the site ────────────────────────────────────────────────────────────────
{$PORTAL_DOMAIN} {
	encode zstd gzip

	# Staging sets CADDY_EXTRA_HEADERS ("X-Robots-Tag: noindex, nofollow") so
	# search engines never index the UAT copy. Empty in production.
	header {
		{$CADDY_EXTRA_HEADERS:}
	}

	# The Loyverse receipts webhook authenticates with a shared secret carried
	# in the URL PATH (Loyverse's dashboard webhooks cannot send headers). The
	# access log records the URI, so logging this route would write a live
	# credential in cleartext into the same volume that holds the TLS private
	# key - the volume most likely to be snapshotted or copied off the box.
	# Anyone holding that secret can post forged receipts and move real money
	# in the cafeteria ledger, so this route is excluded from the log entirely.
	@loyverse_webhook path /api/v1/cafeteria/loyverse/webhook/*
	log_skip @loyverse_webhook

	reverse_proxy app:8000 {
		# Django runs with SECURE_SSL_REDIRECT and trusts
		# SECURE_PROXY_SSL_HEADER = ('HTTP_X_FORWARDED_PROTO', 'https').
		# Without this header every request would be redirected to https
		# forever, in a loop. Caddy sets it by default; it is written out
		# explicitly so a future edit cannot silently remove it.
		header_up X-Forwarded-Proto {scheme}

		# USE_X_FORWARDED_HOST is NOT enabled, so Django validates the real
		# Host header against ALLOWED_HOSTS. Pass the original host through.
		header_up Host {host}

		# The app reads this to restore the true client address (see
		# apps/core/client_ip.py). This is a SET, not an append, so a value
		# supplied by the client is discarded and cannot forge an identity.
		# Rate limiting and brute-force lockout both depend on it.
		header_up X-Real-IP {remote_host}
	}

	# Django emits its own HSTS header (one year, includeSubDomains), so Caddy
	# must not add a second one. Note this is served from the APEX: any future
	# subdomain of interlaken.edu.mx will be forced to HTTPS by browsers that
	# have visited this site. Nothing else exists under the domain today (no
	# mail, webmail or LMS host), which is what makes that safe.

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
