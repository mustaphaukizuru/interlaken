# Colegio Interlaken — backend environment template.
# Copy to ../.env (repo root) and fill in real values. NEVER commit the real .env.

# --- Django core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# PROD: ALLOWED_HOSTS=interlaken.edu.mx,www.interlaken.edu.mx

# --- Database (MySQL in prod) ---
# dev: set SQLITE_LOCAL=1 to use SQLite and ignore the DB_* values below
DB_ENGINE=django.db.backends.mysql
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=3306

# --- Google OAuth ---
# The redirect URI MUST end with a trailing slash to match the Django route
# /auth/google/callback/ and MUST be registered verbatim in Google Cloud Console.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback/
# PROD: GOOGLE_REDIRECT_URI=https://interlaken.edu.mx/auth/google/callback/

# --- Loyverse (cafeteria POS) ---
LOYVERSE_API_TOKEN=your-loyverse-api-token
LOYVERSE_APP_ID=your-loyverse-app-id

# --- Payments (cafeteria top-ups) ---
# Default gateway when the client doesn't pick one: global_payments | banorte
DEFAULT_PAYMENT_GATEWAY=global_payments
# Where the hosted page returns the parent (frontend reads ?payment_id=&status=).
# Defaults to <FRONTEND_URL>/portal/cafeteria/recarga/retorno if left blank.
PAYMENT_RETURN_URL=

# Global Payments (Hosted Payment Page)
GLOBAL_PAYMENTS_APP_ID=
GLOBAL_PAYMENTS_APP_KEY=
GLOBAL_PAYMENTS_ENV=sandbox
# Override the built-in sandbox HPP URL if the provider gives you a specific one.
GLOBAL_PAYMENTS_HPP_URL=
# HMAC-SHA256 secret used to verify Global Payments webhooks (X-Webhook-Signature).
GLOBAL_PAYMENTS_WEBHOOK_SECRET=

# Banorte "Pago en Línea" hosted checkout
BANORTE_MERCHANT_ID=
BANORTE_ENV=sandbox
BANORTE_CHECKOUT_URL=
# HMAC-SHA256 secret used to verify Banorte webhooks (X-Webhook-Signature).
BANORTE_WEBHOOK_SECRET=

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# PROD: FRONTEND_URL=https://interlaken.edu.mx
# PROD: CORS_ALLOWED_ORIGINS=https://interlaken.edu.mx,https://www.interlaken.edu.mx

# --- Email ---
# Dev: console backend prints emails to stdout (no SMTP needed).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@interlaken.edu.mx
# PROD (cPanel SMTP — one of the interlaken.edu.mx mailboxes):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=mail.interlaken.edu.mx
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=noreply@interlaken.edu.mx
# EMAIL_HOST_PASSWORD=your-mailbox-password

# --- WhatsApp ---
WHATSAPP_NUMBER=5215500000000

# --- Error monitoring (Sentry) — optional ---
# Leave SENTRY_DSN blank to disable error monitoring entirely (no-op).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=interlaken@2025.10.0
SENTRY_TRACES_SAMPLE_RATE=0.0
