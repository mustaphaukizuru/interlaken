###############################################################################
# Colegio Interlaken — backend .env EXAMPLE (safe to commit)
# Copy to repo-root ../.env and replace every __PASTE__ with a real value.
###############################################################################

# --- 1) REQUIRED ---
SECRET_KEY=__PASTE__
SQLITE_LOCAL=1
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Loyverse Back Office → Settings → Access tokens → + Add
# Paste the Personal Access Token ONLY (not Developer App ID / App Secret).
LOYVERSE_API_TOKEN=__PASTE__
CAFETERIA_SYNC_PURCHASES_SINCE=2026-08-07T16:00:00Z

FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- 2) GOOGLE LOGIN ---
# console.cloud.google.com → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=__PASTE__.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=__PASTE__
# Empty = invite-only Google login (email must already exist). Optional:
# GOOGLE_AUTO_CREATE_DOMAINS=interlaken.edu.mx
GOOGLE_AUTO_CREATE_DOMAINS=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback/

# --- 3) EMAIL ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@interlaken.edu.mx
CONTACT_EMAIL=info@interlaken.com.mx
ADMISSIONS_EMAIL=info@interlaken.com.mx
BILLING_EMAIL=facturas@interlaken.com.mx
SUPPORT_EMAIL=info@interlaken.com.mx
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=mail.interlaken.edu.mx
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=__PASTE__@interlaken.edu.mx
# EMAIL_HOST_PASSWORD=__PASTE__

# --- 4) DATABASE (ignored when SQLITE_LOCAL=1) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=__PASTE__
DB_USER=__PASTE__
DB_PASSWORD=__PASTE__
DB_HOST=localhost
DB_PORT=5432
# require for Supabase/managed Postgres; disable for a plain local server.
DB_SSLMODE=require

# --- 5) PAYMENTS: Banorte only (docs/BANORTE-INTEGRATION.md) ---
# Leave the BANORTE_* values empty for local development: the top-up then uses
# the /pago/simulado mock. With them set and PAYMENTS_LIVE=false, Banorte runs
# the Payworks simulation in BANORTE_MODE (AUT approves, DEC declines, RND
# random). PAYMENTS_LIVE=true always sends PRD (real money).
# WARNING: never put the real merchant password in a local .env.
PAYMENTS_LIVE=false
BACKEND_URL=http://localhost:8000
BANORTE_MERCHANT_ID=
BANORTE_USER=
BANORTE_PASSWORD=
BANORTE_TERMINAL_ID=
BANORTE_MERCHANT_NAME='Colegio Interlaken'
BANORTE_MERCHANT_CITY=
BANORTE_MODE=AUT
# The yearly .cer from Banorte: a file path, or its Base64 body on one line.
BANORTE_CERT_PATH=
BANORTE_CERT=
# While PAYMENTS_LIVE=false a deployed server runs Banorte's simulation (every
# card approved): only these comma-separated accounts may pay online there.
PAYMENTS_TEST_EMAILS=

# Optional feature toggles (env bools already used in settings — document only):
# CSP_ENABLED=true
# CSP_REPORT_ONLY=false


# --- 6) WHATSAPP ---
WHATSAPP_NUMBER=5215553791188
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v19.0

# --- 7) GOOGLE CALENDAR (optional) ---
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_SA_KEY=

# --- 8) WEB PUSH (optional) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=info@interlaken.com.mx

# --- 9) FIELD ENCRYPTION ---
FIELD_ENCRYPTION_KEY=

# --- 10) SENTRY (optional) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
