# Colegio Interlaken — backend environment template.
# Copy to ../.env (repo root) and fill in real values. NEVER commit the real .env.

# --- Django core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# PROD: ALLOWED_HOSTS=interlaken.edu.mx,www.interlaken.edu.mx

# --- Database (MySQL in prod) ---
# dev: set SQLITE_LOCAL=1 to use SQLite and ignore the DB_* values below
DB_ENGINE=django.db.backends.mysql
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=3306

# --- Google OAuth ---
# The redirect URI MUST end with a trailing slash to match the Django route
# /auth/google/callback/ and MUST be registered verbatim in Google Cloud Console.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback/
# PROD: GOOGLE_REDIRECT_URI=https://interlaken.edu.mx/auth/google/callback/

# --- Web push (VAPID) — optional; notifications stay in-app/email until set ---
# Generate once: pip install py-vapid && vapid --gen  (see apps/portal/push.py).
# Put the SAME public key in the frontend as VITE_VAPID_PUBLIC_KEY (.env.local).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=colegio@interlaken.edu.mx

# --- Loyverse (cafeteria POS) ---
LOYVERSE_API_TOKEN=your-loyverse-api-token

# --- Payments (cafeteria top-ups) ---
# Default gateway when the client doesn't pick one: global_payments | banorte
DEFAULT_PAYMENT_GATEWAY=global_payments
# Where the hosted page returns the parent (frontend reads ?payment_id=&status=).
# Defaults to <FRONTEND_URL>/portal/cafeteria/recarga/retorno if left blank.
PAYMENT_RETURN_URL=

# Global Payments (Hosted Payment Page)
GLOBAL_PAYMENTS_APP_ID=
GLOBAL_PAYMENTS_APP_KEY=
GLOBAL_PAYMENTS_ENV=sandbox
# Override the built-in sandbox HPP URL if the provider gives you a specific one.
GLOBAL_PAYMENTS_HPP_URL=
# HMAC-SHA256 secret used to verify Global Payments webhooks (X-Webhook-Signature).
GLOBAL_PAYMENTS_WEBHOOK_SECRET=

# Banorte "Pago en Línea" hosted checkout
BANORTE_MERCHANT_ID=
BANORTE_ENV=sandbox
BANORTE_CHECKOUT_URL=
# HMAC-SHA256 secret used to verify Banorte webhooks (X-Webhook-Signature).
BANORTE_WEBHOOK_SECRET=

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# PROD: FRONTEND_URL=https://interlaken.edu.mx
# PROD: CORS_ALLOWED_ORIGINS=https://interlaken.edu.mx,https://www.interlaken.edu.mx

# --- Field encryption (at-rest, e.g. medical data — see apps/core/fields.py) ---
# Dedicated Fernet key (urlsafe base64, 32 bytes):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank in dev (derived from SECRET_KEY). Set a REAL, stable key in prod —
# rotating SECRET_KEY without this set would make encrypted data unreadable.
# FIELD_ENCRYPTION_KEY=

# --- Auth cookies (httpOnly refresh + double-submit CSRF; see AUTH.md) ---
# Defaults: Secure=off when DEBUG=True, SameSite=Lax. Same-origin (SPA served by
# Django in prod, Vite proxy in dev) works with these defaults.
# AUTH_COOKIE_SECURE=True            # force on in prod (HTTPS)
# AUTH_COOKIE_SAMESITE=Lax           # use None (+Secure, HTTPS) only for split-origin
# AUTH_COOKIE_DOMAIN=                 # e.g. .interlaken.edu.mx to share across subdomains

# --- Email ---
# Dev: console backend prints emails to stdout (no SMTP needed).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@interlaken.edu.mx
# Inbox that receives contact-form messages AND new pre-registration alerts.
# Falls back to DEFAULT_FROM_EMAIL if unset.
CONTACT_EMAIL=admisiones@interlaken.edu.mx
# PROD (cPanel SMTP — one of the interlaken.edu.mx mailboxes):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=mail.interlaken.edu.mx
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=noreply@interlaken.edu.mx
# EMAIL_HOST_PASSWORD=your-mailbox-password

# --- Google Calendar (bookings) — optional, service account ---
# Both blank → calendar sync is a no-op (bookings still succeed, fail-soft).
# GOOGLE_CALENDAR_SA_KEY is a filesystem PATH to the service-account key JSON —
# never commit the key file. See BOOKING_CALENDAR_SPEC.md §3 / DEPLOYMENT.md §8.
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_SA_KEY=

# --- WhatsApp ---
# Tier 1 (deep link, zero setup): the "Reservar por WhatsApp" button uses this.
WHATSAPP_NUMBER=5215500000000
# Tier 2 (conversational Cloud API bot) — all blank → the webhook still verifies
# signatures + answers Meta's handshake, but outbound sends are no-ops (no crash).
# Get these from Meta for Developers → WhatsApp → API Setup. See DEPLOYMENT.md §10.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Shared secret you invent; also entered in Meta's webhook "Verify token" field.
WHATSAPP_VERIFY_TOKEN=
# App Secret (Meta → App Settings → Basic) — verifies X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Graph API version for outbound Cloud API calls.
WHATSAPP_API_VERSION=v19.0

# --- Error monitoring (Sentry) — optional ---
# Leave SENTRY_DSN blank to disable error monitoring entirely (no-op).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=interlaken@2025.10.0
SENTRY_TRACES_SAMPLE_RATE=0.0
