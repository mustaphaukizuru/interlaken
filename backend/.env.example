###############################################################################
# Colegio Interlaken — backend .env EXAMPLE (safe to commit)
# Copy to repo-root ../.env and replace every __PASTE__ with a real value.
###############################################################################

# --- 1) REQUIRED ---
SECRET_KEY=__PASTE__
SQLITE_LOCAL=1
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Loyverse Back Office → Settings → Access tokens → + Add
# Paste the Personal Access Token ONLY (not Developer App ID / App Secret).
LOYVERSE_API_TOKEN=__PASTE__
CAFETERIA_SYNC_PURCHASES_SINCE=2026-08-07T16:00:00Z

FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- 2) GOOGLE LOGIN ---
# console.cloud.google.com → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=__PASTE__.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=__PASTE__
# Empty = invite-only Google login (email must already exist). Optional:
# GOOGLE_AUTO_CREATE_DOMAINS=interlaken.edu.mx
GOOGLE_AUTO_CREATE_DOMAINS=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback/

# --- 3) EMAIL ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@interlaken.edu.mx
CONTACT_EMAIL=admisiones@interlaken.edu.mx
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=mail.interlaken.edu.mx
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=__PASTE__@interlaken.edu.mx
# EMAIL_HOST_PASSWORD=__PASTE__

# --- 4) DATABASE (ignored when SQLITE_LOCAL=1) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=__PASTE__
DB_USER=__PASTE__
DB_PASSWORD=__PASTE__
DB_HOST=localhost
DB_PORT=5432
# require for Supabase/managed Postgres; disable for a plain local server.
DB_SSLMODE=require

# --- 5) PAYMENTS ---
# PAYMENTS_LIVE=false (default) forces sandbox checkout URLs even if a live
# HPP/checkout URL is present in env. Flip to true only with real merchant creds.
# Empty HPP/checkout URL → local /pago/simulado mock (DEV only settle).
# Set *_SESSION_URL when the merchant gives a real HPP session API endpoint.
PAYMENTS_LIVE=false
DEFAULT_PAYMENT_GATEWAY=global_payments
BACKEND_URL=http://localhost:8000
PAYMENT_RETURN_URL=
GLOBAL_PAYMENTS_APP_ID=
GLOBAL_PAYMENTS_APP_KEY=
GLOBAL_PAYMENTS_ENV=sandbox
GLOBAL_PAYMENTS_HPP_URL=
GLOBAL_PAYMENTS_SESSION_URL=
GLOBAL_PAYMENTS_API_VERSION=2021-03-22
GLOBAL_PAYMENTS_WEBHOOK_SECRET=
BANORTE_MERCHANT_ID=
BANORTE_API_KEY=
BANORTE_ENV=sandbox
BANORTE_CHECKOUT_URL=
BANORTE_SESSION_URL=
BANORTE_WEBHOOK_SECRET=

# Optional feature toggles (env bools already used in settings — document only):
# CSP_ENABLED=true
# CSP_REPORT_ONLY=false


# --- 6) WHATSAPP ---
WHATSAPP_NUMBER=5215553791188
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v19.0

# --- 7) GOOGLE CALENDAR (optional) ---
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_SA_KEY=

# --- 8) WEB PUSH (optional) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=colegio@interlaken.edu.mx

# --- 9) FIELD ENCRYPTION ---
FIELD_ENCRYPTION_KEY=

# --- 10) SENTRY (optional) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
