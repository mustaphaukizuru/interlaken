# Colegio Interlaken — PRODUCTION backend environment template (cPanel / GoDaddy).
#
# Copy this to `.env` ON THE SERVER ONLY (e.g. /home/rene82/<app>/.env),
# fill in the real values, and `chmod 600 .env`. NEVER commit the filled file
# or any secret. See DEPLOYMENT.md §4, §8, §9, §10.
#
# The server .env is the ONLY place production secrets live. Your local .env
# stays on SQLite/localhost and is untouched by this.

# ── Core ─────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_generate_with: python -c "import secrets; print('interlaken-'+secrets.token_urlsafe(48))"
DEBUG=False
ALLOWED_HOSTS=interlaken.edu.mx,www.interlaken.edu.mx
FRONTEND_URL=https://interlaken.edu.mx
CORS_ALLOWED_ORIGINS=https://interlaken.edu.mx

# ── Database (match the DB/user you create in cPanel → MySQL) ──
DB_ENGINE=django.db.backends.mysql
DB_NAME=rene82_interla
DB_USER=rene82_interla
DB_PASSWORD=CHANGE_ME
DB_HOST=localhost
DB_PORT=3306

# ── Google OAuth login (rotate the secret before go-live — DEPLOYMENT.md §6) ──
# Register the EXACT redirect (with trailing slash) in Cloud Console.
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
# Empty = invite-only (recommended). Comma-separated domains may self-provision.
GOOGLE_AUTO_CREATE_DOMAINS=
GOOGLE_REDIRECT_URI=https://interlaken.edu.mx/auth/google/callback/

# ── Email (cPanel SMTP — switch off the console backend) ──
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.interlaken.edu.mx
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=CHANGE_ME@interlaken.edu.mx
EMAIL_HOST_PASSWORD=CHANGE_ME
DEFAULT_FROM_EMAIL=Colegio Interlaken <no-reply@interlaken.edu.mx>

# ── Loyverse (cafeteria) — rotate the token before go-live ──
LOYVERSE_API_TOKEN=CHANGE_ME
LOYVERSE_APP_ID=CHANGE_ME
# ISO-8601 go-live watermark — first sync_purchases run MUST NOT backfill history
# (opening balances already include past Loyverse spend). See DEPLOYMENT.md §3.
CAFETERIA_SYNC_PURCHASES_SINCE=2026-08-07T16:00:00Z

# ── Contact inbox (public forms / admissions) ──
CONTACT_EMAIL=admisiones@interlaken.edu.mx

# ── Field encryption (medical / PII at rest) ──
# Generate once before real registration data accumulates:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If blank, Django derives a key from SECRET_KEY (rotate carefully).
FIELD_ENCRYPTION_KEY=

# ── Web push (optional; inert until VAPID_* are set) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=colegio@interlaken.edu.mx

# ── Cafeteria online top-ups / tuition payments (DEPLOYMENT.md §9) ──
# Keep PAYMENTS_LIVE=false until live merchant creds are verified — sandbox
# mode ignores live HPP/checkout hosts even if set below. The webhook secrets
# MUST be set in every environment or the endpoint 401s all calls.
PAYMENTS_LIVE=false
DEFAULT_PAYMENT_GATEWAY=global_payments
BACKEND_URL=https://interlaken.edu.mx
PAYMENT_RETURN_URL=https://interlaken.edu.mx/portal/cafeteria/recarga/retorno
TUITION_RETURN_URL=https://interlaken.edu.mx/portal/colegiaturas/retorno
GLOBAL_PAYMENTS_APP_ID=
GLOBAL_PAYMENTS_APP_KEY=
GLOBAL_PAYMENTS_ENV=sandbox
GLOBAL_PAYMENTS_HPP_URL=
GLOBAL_PAYMENTS_SESSION_URL=
GLOBAL_PAYMENTS_API_VERSION=2021-03-22
GLOBAL_PAYMENTS_WEBHOOK_SECRET=CHANGE_ME
BANORTE_MERCHANT_ID=
BANORTE_API_KEY=
BANORTE_ENV=sandbox
BANORTE_CHECKOUT_URL=
BANORTE_SESSION_URL=
BANORTE_WEBHOOK_SECRET=CHANGE_ME

# ── Google Calendar for bookings (service account — DEPLOYMENT.md §8) ──
# Upload the JSON key OUTSIDE the docroot, chmod 600. Leave blank to no-op.
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_SA_KEY=/home/rene82/secrets/interlaken-calendar.json

# ── WhatsApp booking (DEPLOYMENT.md §10) ──
# Tier 1 (deep link) only needs WHATSAPP_NUMBER. Tier 2 (bot) needs the rest.
WHATSAPP_NUMBER=52155CHANGE_ME
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v19.0

# ── Error monitoring (optional; no-op unless set) ──
SENTRY_DSN=
