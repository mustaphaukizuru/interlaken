__pycache__/
*.pyc
*.pyo
.env
.env.local
CLAUDE.md
*.sqlite3
*.sqlite3-journal
db_local.sqlite3
venv/
backend/venv/
backend/staticfiles/
backend/media/
backend/db.sqlite3
frontend/node_modules/
frontend/dist/
frontend/.env*.local
# Bundle treemap from `ANALYZE=1 npm run build` (rollup-plugin-visualizer)
frontend/stats.html
# Playwright E2E artifacts
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/
.vscode/
.idea/
*.log
Thumbs.db
.DS_Store

.claude/

# Ignore the bulky campus imagery in assets/, but keep the official logo
# source PNGs tracked as the source of truth for scripts/build-logos.py.
frontend/assets/*
!frontend/assets/logo-horizontal.png
!frontend/assets/logo-vertical.png
!frontend/assets/logo-40 anos.png
backups/

# Rate-limit file cache (created at runtime in production)
.ratelimit-cache/

# Generated client deliverables (progress report / feature checklist). They are
# rebuilt from the docs in this folder, so the binaries stay out of git.
docs/*.docx

# Local source material (brand PDFs/logos), not app assets
resources/

# SPA build artifacts staged for Django (scripts/build_frontend.py). The Render
# Docker image builds these fresh; only backend/static/admin/ is hand-managed.
backend/static/*
!backend/static/admin/

# Local secrets handoff (VAPID) - paste into Render, never commit
*.local.txt
