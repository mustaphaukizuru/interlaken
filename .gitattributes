# Normalize line endings: LF in the repo AND in Windows working trees.
# Ends the recurring CRLF traps (CI hash mismatches, PowerShell mojibake edits,
# noisy "CRLF will be replaced" warnings on every commit) documented in
# docs/DEPLOY_RENDER.md and the 2026-08-12 incident notes.
* text=auto eol=lf

# Windows-native scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=lf

# Binaries — never normalize.
*.png binary
*.ico binary
*.webp binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.gz binary
*.zip binary
*.sqlite3 binary
