# Keep the Docker build context small — everything below is rebuilt in-image or
# is local-only / secret.
.git
**/node_modules
**/venv
**/.venv
**/__pycache__
**/*.pyc
**/dist
backend/staticfiles
backend/media
backend/.ratelimit-cache
**/*.sqlite3
**/db_local.sqlite3
.env
**/.env
**/.env.*
frontend/coverage
frontend/playwright-report
frontend/test-results
# Playwright specs + ~3MB of visual baselines never run in the image.
frontend/e2e
